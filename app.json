{
  "expo": {
    "name": "OnTime",
    "slug": "gestionnaire-de-delai",
    "owner": "kafandogael",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/app-logo.png",
    "scheme": "delai-manager",
    "extra": {
      "apiUrl": "https://delai-manager.onrender.com/api",
      "eas": {
        "projectId": "7e1d2e12-b8fa-4b92-8e0f-6ada150b79fb"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#2563EB",
          "sounds": [
            "./assets/sounds/urgent.wav"
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/app-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "expo-font"
    ],
    "ios": {
      "bundleIdentifier": "com.delaimanager.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Recevez des rappels pour vos échéances importantes (passeport, assurance, loyer...).",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.delaimanager.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-logo.png",
        "backgroundColor": "#F8FAFC"
      }
    }
  }
}
