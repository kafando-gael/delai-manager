PORT=3200
NODE_ENV=production

# URL publique du serveur (obligatoire en prod — webhooks Sunrise Pay)
PUBLIC_API_URL=https://your-api.onrender.com

# Sunrise Pay
SUNRISE_PAY_URL=https://sunrise-pay.onrender.com
SUNRISE_PAY_API_KEY=change-me

# Secret partagé pour sécuriser les webhooks (header: x-webhook-secret)
WEBHOOK_SECRET=change-me-long-random-secret

SUBSCRIPTION_ANNUAL_FCFA=1000
APP_RETURN_SCHEME=delai-manager

# Supabase — Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optionnel — origines CORS autorisées (séparées par des virgules)
# CORS_ORIGINS=https://admin.example.com
