{
  "name": "ontime",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "bash scripts/expo-start.sh",
    "start:tunnel": "bash scripts/expo-start.sh --clear",
    "android": "bash scripts/run-with-node20.sh expo start --android",
    "ios": "bash scripts/run-with-node20.sh expo start --ios",
    "web": "bash scripts/run-with-node20.sh expo start --web",
    "server": "bash scripts/run-with-node20.sh sh -c 'cd server && npm start'",
    "server:dev": "bash scripts/run-with-node20.sh sh -c 'cd server && npm run dev'"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "^8.4.4",
    "expo": "^54.0.35",
    "expo-notifications": "^0.32.17",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "react": "^19.1.0",
    "react-native": "^0.81.5",
    "react-native-webview": "^13.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2"
  }
}
